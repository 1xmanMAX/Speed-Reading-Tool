<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vibración breve al pasar por un tamaño o velocidad favoritos -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 11+: hace visibles los motores de voz instalados -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- PixPin Pro: devolverle el progreso de lectura (marcador verde) -->
        <package android:name="com.forge.pixpin" />
    </queries>
    <application>
        <!-- «Abrir en PixPin»: el documento del libro se le pasa a PixPin con permiso
             de lectura temporal (solo la carpeta cache/abrir-en-pixpin/). -->
        <provider
            android:name="com.lecturaveloz.tts.LvFileProvider"
            android:authorities="${applicationId}.lvfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/lv_file_paths" />
        </provider>
    </application>
</manifest>
