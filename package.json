{
  "name": "lectura-veloz",
  "private": true,
  "version": "1.0.0",
  "description": "Lectura Veloz - lector rápido RSVP (web, PWA, escritorio y móvil con Tauri 2)",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "icon": "tauri icon src-tauri/icons/icon.png",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --aab",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "serve": "npm run vendor && npx --yes http-server web -p 8080 -c-1",
    "test": "node tests/e2e.js",
    "vendor": "node scripts/vendor.mjs",
    "android:apk": "tauri android build --apk",
    "pretest": "npm run vendor"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@tauri-apps/cli": "^2",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "onnxruntime-web": "1.20.1",
    "pdfjs-dist": "3.11.174"
  }
}
